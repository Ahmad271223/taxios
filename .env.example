# Kopiere diese Datei nach .env und passe die Werte an.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="bitte-aendern"
PORT=3000
DEFAULT_LAT=52.375892
DEFAULT_LNG=9.732010
ENABLE_SIMULATOR=1
TARIFF_BASE=3.90
TARIFF_PER_KM=2.20
TARIFF_PER_MIN=0.40

APP_BASE_URL=http://localhost:3000

# Twilio (echte SMS) – leer = nur Log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Stripe (Kartenzahlung + Connect) – leer = deaktiviert
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=0
